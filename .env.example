# ============================================================================
# SIGAA UFPA MCP Server — Variáveis de Ambiente (Zero-Token Edition)
# Nenhuma chave de API de LLM (Gemini/OpenAI/Groq) é necessária!
# ============================================================================

# Credenciais do SIGAA UFPA (OPCIONAIS — se vazias, use o Login Visual no Chat ou http://localhost:8003/login)
SIGAA_USERNAME=
SIGAA_PASSWORD=

# Matrícula preferencial caso possua múltiplos vínculos ativos no SIGAA (OPCIONAL)
SIGAA_MATRICULA=

# Transporte e Rede do Servidor FastMCP 4.1
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8003
LOG_LEVEL=INFO

# Configurações do Chromium / Playwright e VNC (Docker)
CHROME_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
VNC_PASSWORD=sigaa

# Armazenamento de Arquivos e Sessão Opcional
DOWNLOAD_PATH=./downloads
STORAGE_STATE_PATH=.sigaa_state/storage_state.json

# Integração Opcional com Google Drive (OAuth 2.0)
DRIVE_FOLDER_ID=
DRIVE_CLIENT_SECRETS_PATH=client_secrets.json
DRIVE_TOKEN_PATH=token.json
